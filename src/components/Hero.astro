---
// No props — hero content is fixed
---

<header class="border-b border-border">
  <nav class="max-w-5xl mx-auto px-6 h-14 flex items-center justify-between">
    <span class="font-mono text-sm font-medium text-text-primary">memnotary</span>
    <div class="flex items-center gap-6">
      <a
        href="https://github.com/Jishudayal/MemNotary"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors"
      >GitHub</a>
      <a
        href="https://pypi.org/project/memnotary"
        class="text-sm text-text-secondary hover:text-text-primary transition-colors"
      >PyPI</a>
    </div>
  </nav>
</header>

<section class="min-h-[calc(100vh-3.5rem)] flex items-center">
  <div class="max-w-5xl mx-auto px-6 py-24 w-full">

    <!-- Version badge -->
    <div class="mb-8">
      <span class="inline-flex items-center gap-2 text-xs font-mono text-accent border border-accent/20 bg-accent/5 px-3 py-1 rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
        v0.1.1 · open source · MIT
      </span>
    </div>

    <!-- Headline -->
    <h1 class="text-5xl sm:text-6xl lg:text-[4.5rem] font-semibold tracking-tight leading-[1.08] text-text-primary mb-6 max-w-3xl">
      Memory your AI agents<br />can actually trust.
    </h1>

    <!-- Sub-headline -->
    <p class="text-lg text-text-secondary leading-relaxed mb-10 max-w-lg">
      The open-source reliability layer for AI agent memory.
      Contradiction detection, health scoring, and automatic consolidation —
      wraps your existing vector backend.
    </p>

    <!-- pip install copy block -->
    <div class="mb-10">
      <div class="inline-flex items-center gap-3 bg-bg-secondary border border-border rounded-lg px-4 py-3">
        <span class="font-mono text-sm text-text-tertiary select-none">$</span>
        <span class="font-mono text-sm text-text-primary">pip install memnotary</span>
        <button
          id="copy-btn"
          aria-label="Copy to clipboard"
          class="ml-2 text-text-tertiary hover:text-accent transition-colors"
        >
          <svg id="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg id="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden text-accent">
            <polyline points="20 6 9 20 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- CTAs -->
    <div class="flex items-center gap-4 flex-wrap">
      <a
        href="https://github.com/Jishudayal/MemNotary"
        class="inline-flex items-center gap-2 bg-text-primary text-bg-primary text-sm font-medium px-5 py-2.5 rounded-lg hover:bg-text-secondary transition-colors"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12c0-5.523-4.477-10-10-10z"/>
        </svg>
        View on GitHub
      </a>
      <a
        href="#benchmark"
        class="inline-flex items-center gap-1.5 text-sm text-text-secondary hover:text-accent transition-colors"
      >
        Read the benchmark
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  const btn = document.getElementById("copy-btn");
  const copyIcon = document.getElementById("copy-icon");
  const checkIcon = document.getElementById("check-icon");

  btn?.addEventListener("click", () => {
    navigator.clipboard.writeText("pip install memnotary").then(() => {
      copyIcon?.classList.add("hidden");
      checkIcon?.classList.remove("hidden");
      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
      }, 2000);
    });
  });
</script>
